# ---------- Telegram ----------
# @BotFather'dan aldığın token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Bildirim gidecek chat id(ler), virgülle. Bulmak için: python bot.py --chat-id
TELEGRAM_CHAT_ID=

# ---------- Taranacak pariteler ----------
# ALL = Binance'teki tüm USDT pariteleri (hacme göre ilk TOP_N)
# ya da elle: BTCUSDT,ETHUSDT,SOLUSDT
BINANCE_SYMBOLS=ALL
QUOTE=USDT
TOP_N=100
# Binance engelliyse dene: https://data-api.binance.vision
BINANCE_BASE=https://api.binance.com

# ---------- Dürbün ----------
# Dürbün aranacak üst zaman dilimleri
INTERVALS=4h,1h
# UP = yükseliş, DOWN = düşüş
DIRECTIONS=UP,DOWN
# 1 = ortadaki mumların iğneleri de çizgiyi geçemez (daha katı)
STRICT_WICKS=0

# ---------- ChoCh onayı (BoS/ChoCh Nephew_Sam_ ayarları) ----------
# Üst TF : onay aranacak alt TF
LTF_MAP=1d:1h,4h:15m,2h:15m,1h:5m,30m:5m,15m:1m
PIVOT_LB=5
PIVOT_RB=5
# close = kırılım kapanışla onaylanır, wick = iğne yeter
BREAKOUT_CONFIRM=close
# CHOCH ya da CHOCH,BOS (BOS'u da onay saymak için)
CONFIRM_KINDS=CHOCH
# Dürbünden sonra kaç üst TF mumu boyunca ChoCh beklensin
SETUP_EXPIRE_BARS=6
# 1 = fiyat dürbünün dibini (yükselişte) / tepesini (düşüşte) kapanışla kırarsa iptal
INVALIDATE=1
# 1 = dürbün bulunduğunda da (onay beklemeden) bildirim at
NOTIFY_PENDING=0

# ---------- Genel ----------
CHECK_EVERY_SECONDS=60
MAX_WORKERS=8
TIMEZONE=Europe/Istanbul
STARTUP_MESSAGE=1
