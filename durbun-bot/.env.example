# @BotFather'dan aldığın token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Bildirim gidecek chat id(ler), virgülle. Bulmak için: python bot.py --chat-id
TELEGRAM_CHAT_ID=

# Kripto (Binance spot) sembolleri
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Hisse / BIST (Yahoo Finance), ör. THYAO.IS,ASELS.IS  (pip install yfinance gerekir)
YAHOO_SYMBOLS=

# Periyotlar: 1m,5m,15m,30m,1h,4h,1d,1w  (Yahoo'da 4h yok)
INTERVALS=1h,4h

# UP = yükseliş, DOWN = düşüş
DIRECTIONS=UP,DOWN
# 1 yaparsan ortadaki mumların iğneleri de çizgiyi geçemez (daha katı)
STRICT_WICKS=0
CHECK_EVERY_SECONDS=60
STARTUP_MESSAGE=1
